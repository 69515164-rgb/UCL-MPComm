# =============================================================================
# MPComm Multi-Initiator Test Configuration (for multi_initiator_test.sh)
#
# Format: INI-style sections, one section per test job.
#
# Sections:
#   [global]      - Optional. Default test parameters inherited by every job.
#   [jobs order]  - Optional. Comma/space separated list fixing job execution
#                   order. If omitted, jobs run in the order they appear below.
#   [<job_name>]  - One section per job. Each job defines one initiator and
#                   one or more targets, plus optional per-job parameters.
#
# Per-job fields:
#   initiator = <HOST>                       (required, exactly one)
#   target    = <HOST> [<HOST> ...]          (required, one or more lines;
#                                             multiple HOSTs may share a line)
#   size        = ...    (optional)     override global --size
#   iterations  = ...    (optional)
#   warmup      = ...    (optional)
#   batch-size  = ...    (optional)
#   gpu         = ...    (optional)
#   both        = true|false (optional)
#   test-type   = ...    (optional, comma-separated: scatter,gather,broadcast)
#   buffer-size = ...    (optional)     target-side buffer size
#
# HOST syntax:
#   ID                 - Use the default NUMA spec from hosts.txt.
#   ID[NUMA]           - Override NUMA for this role only. NUMA may be a
#                        comma list, e.g. 3[0,1].
#
# Notes:
#   - HOST IDs must match entries in hosts.txt. The IP, TCP port, and default
#     NUMA spec are looked up there. A single physical machine may appear as
#     initiator in one job AND as target in other jobs simultaneously, since
#     each host runs exactly one MPComm process bound to its single TCP port.
#   - 'target' lines can be repeated AND/OR list multiple hosts on one line.
#     The two forms are equivalent:
#         target = 3 4 5
#         target = 3
#         target = 4
#         target = 5
#   - Lines starting with '#' are comments. Blank lines are ignored.
#
# Example: 4-machine cross-traffic scenario (all referencing hosts.txt IDs)
#   Job A: 1 (initiator) -> 3, 4
#   Job B: 3 (initiator) -> 1, 2, 4
#   Job C: 4 (initiator) -> 1, 3
# =============================================================================

[global]
size        = 1G
iterations  = 20
warmup      = 5
test-type   = scatter
buffer-size = 2G

[jobA]
initiator = 1
target    = 3 4

[jobB]
initiator = 3[1]
target    = 1[1] 2 4[1]
size      = 512M
test-type = gather

[jobC]
initiator = 4
target    = 1 3
