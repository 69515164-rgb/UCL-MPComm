@PACKAGE_INIT@

# mpcommConfig.cmake - CMake package configuration file for MPComm
#
# This file is generated by CMake's configure_package_config_file() and
# installed alongside the MPComm library.
#
# Usage in user's CMakeLists.txt:
#
#   find_package(mpcomm REQUIRED)
#
#   # Link against the shared library (recommended):
#   target_link_libraries(my_app PRIVATE mpcomm::mpcomm)
#
#   # Or link against the static library:
#   target_link_libraries(my_app PRIVATE mpcomm::mpcomm_static)
#

include("${CMAKE_CURRENT_LIST_DIR}/mpcommTargets.cmake")

check_required_components(mpcomm)
