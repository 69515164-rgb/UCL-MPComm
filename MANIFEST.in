# Source files needed for building
include CMakeLists.txt
include pyproject.toml
include VERSION

# C++ source and headers
recursive-include src *.cpp *.h
recursive-include include *.h

# Python binding source
recursive-include python *.cpp *.py

# CMake config template
recursive-include cmake *.cmake.in

# Documentation (for readme)
include docs/MPComm_Introduction.md

# Test / example files bundled into the wheel
include check_install.sh
include user_examples/scatter_test.cpp
include user_examples/CMakeLists.txt
include user_examples/cpp-target.sh
include user_examples/cpp-initiator.sh

# Exclude build artifacts
prune build
prune mpcomm-install
prune .codebuddy
